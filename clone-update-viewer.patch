diff --git a/src/assets/ventilator-working-principle.svg b/src/assets/ventilator-working-principle.svg
new file mode 100644
index 0000000..5b7a76e
--- /dev/null
+++ b/src/assets/ventilator-working-principle.svg
@@ -0,0 +1,270 @@
+<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1000 700" width="100%" height="100%" style="background-color: #0f172a; font-family: Verdana, 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;" role="img" aria-labelledby="svgTitle svgDesc">
+  <title id="svgTitle">Medical ventilator working principle and gas flow diagram</title>
+  <desc id="svgDesc">Step-by-step animated diagram: medical air and oxygen enter under pressure, are mixed to the prescribed oxygen percentage, controlled by a computer, warmed and moistened, delivered to the lungs, then leave through a germ filter and PEEP valve while sensors send feedback to the ventilator.</desc>
+  <defs>
+    <style>
+      .title { font-size: 23px; font-weight: 700; fill: #f8fafc; }
+      .subtitle { font-size: 13px; fill: #94a3b8; }
+      .node-title { font-size: 14px; font-weight: 600; fill: #f1f5f9; }
+      .node-sub { font-size: 11px; fill: #94a3b8; }
+      .label-text { font-size: 12.5px; font-weight: 600; fill: #e2e8f0; }
+      .card-title { font-size: 12px; font-weight: 600; fill: #f1f5f9; }
+      .card-text { font-size: 10.5px; fill: #a8b8cc; }
+      .step-num { font-size: 12px; font-weight: 700; fill: #0f172a; text-anchor: middle; }
+
+      /* Animated glowing flow lines: the moving dashes show direction of travel */
+      .flow-insp { stroke: #38bdf8; stroke-dasharray: 9 7; animation: flowAnimation 1.2s linear infinite; }
+      .flow-exp { stroke: #fb923c; stroke-dasharray: 9 7; animation: flowAnimation 1.2s linear infinite; }
+      .flow-signal { stroke: #c084fc; stroke-dasharray: 4 4; animation: flowAnimation 1.8s linear infinite; }
+      @keyframes flowAnimation { from { stroke-dashoffset: 32; } to { stroke-dashoffset: 0; } }
+
+      /* Gentle breathing motion for the lungs */
+      .lung-pulse { animation: lungBreathe 3s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
+      @keyframes lungBreathe { 0%, 100% { transform: scale(0.96); opacity: 0.85; } 50% { transform: scale(1.05); opacity: 1; } }
+
+      /* Soft pulsing glow on the numbered step badges, in sequence */
+      .badge { animation: badgePulse 3s ease-in-out infinite; }
+      @keyframes badgePulse { 0%, 100% { opacity: 0.75; } 50% { opacity: 1; } }
+
+      @media (prefers-reduced-motion: reduce) {
+        .flow-insp, .flow-exp, .flow-signal, .lung-pulse, .badge { animation: none; }
+      }
+    </style>
+
+    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
+      <stop offset="0%" stop-color="#0f172a" />
+      <stop offset="100%" stop-color="#1e293b" />
+    </linearGradient>
+    <linearGradient id="ventGrad" x1="0%" y1="0%" x2="100%" y2="100%">
+      <stop offset="0%" stop-color="#334155" />
+      <stop offset="100%" stop-color="#1e293b" />
+    </linearGradient>
+    <linearGradient id="screenGrad" x1="0%" y1="0%" x2="0%" y2="100%">
+      <stop offset="0%" stop-color="#0284c7" />
+      <stop offset="100%" stop-color="#0369a1" />
+    </linearGradient>
+    <linearGradient id="humidGrad" x1="0%" y1="0%" x2="0%" y2="100%">
+      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25" />
+      <stop offset="100%" stop-color="#0284c7" stop-opacity="0.65" />
+    </linearGradient>
+
+    <filter id="glowBlue" x="-80%" y="-80%" width="260%" height="260%">
+      <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#38bdf8" flood-opacity="0.9" />
+    </filter>
+    <filter id="glowOrange" x="-80%" y="-80%" width="260%" height="260%">
+      <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="#fb923c" flood-opacity="0.9" />
+    </filter>
+    <filter id="glowPurple" x="-80%" y="-80%" width="260%" height="260%">
+      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#c084fc" flood-opacity="0.9" />
+    </filter>
+
+    <marker id="arrow-blue" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
+      <path d="M 0 1 L 10 5 L 0 9 z" fill="#38bdf8" />
+    </marker>
+    <marker id="arrow-orange" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
+      <path d="M 0 1 L 10 5 L 0 9 z" fill="#fb923c" />
+    </marker>
+  </defs>
+
+  <!-- Background -->
+  <rect width="1000" height="700" fill="url(#bgGrad)" rx="16" />
+
+  <!-- Header -->
+  <g transform="translate(40, 45)">
+    <text class="title" x="0" y="0">Medical Ventilator: Working Principle &amp; Gas Workflow</text>
+    <text class="subtitle" x="0" y="22">How the machine breathes for a patient, step by step — follow the glowing lines</text>
+  </g>
+
+  <!-- Legend -->
+  <g transform="translate(706, 24)">
+    <line x1="0" y1="4" x2="34" y2="4" stroke="#38bdf8" stroke-width="4" />
+    <text class="node-sub" x="42" y="8">Fresh air in (inspiration)</text>
+    <line x1="0" y1="24" x2="34" y2="24" stroke="#fb923c" stroke-width="4" />
+    <text class="node-sub" x="42" y="28">Used air out, with CO₂ (expiration)</text>
+    <line x1="0" y1="44" x2="34" y2="44" stroke="#c084fc" stroke-width="3" stroke-dasharray="4 3" />
+    <text class="node-sub" x="42" y="48">Sensor messages to the computer</text>
+  </g>
+
+  <!-- 1. GAS SUPPLY & BLENDER SECTION -->
+  <g transform="translate(40, 110)">
+    <rect x="0" y="0" width="110" height="45" rx="8" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5"/>
+    <text class="node-title" x="13" y="21" font-size="12.5">Medical Air</text>
+    <text class="node-sub" x="13" y="36">≈50 psi • 400 kPa</text>
+
+    <rect x="0" y="60" width="110" height="45" rx="8" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5"/>
+    <text class="node-title" x="13" y="81" font-size="12.5">O₂ Supply</text>
+    <text class="node-sub" x="13" y="96">≈50 psi • 400 kPa</text>
+
+    <text class="node-sub" x="0" y="124" fill="#7dd3fc">From wall pipeline or cylinders,</text>
+    <text class="node-sub" x="0" y="139" fill="#7dd3fc">steadied by inlet regulators</text>
+
+    <!-- Blender -->
+    <rect x="150" y="15" width="110" height="75" rx="10" fill="url(#ventGrad)" stroke="#64748b" stroke-width="2"/>
+    <text class="node-title" x="162" y="40" font-size="13">Gas Blender</text>
+    <text class="node-sub" x="162" y="57">Electric valves</text>
+    <text class="node-sub" x="162" y="72">mix to set FiO₂</text>
